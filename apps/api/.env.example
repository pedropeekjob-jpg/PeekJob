# Base de dados (local: docker compose up -d db)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/peekjob
# Base de dados dos testes (é recriada pelos testes)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/peekjob_test
# Segredo para pseudonimizar quem avalia (HMAC). Mudar em produção e nunca o versionar.
PRIVACY_SECRET=muda-isto
PORT=3000
# Ambiente: production | uat | (vazio = desenvolvimento)
APP_ENV=
# Só UAT: palavra-passe de acesso (obrigatória quando APP_ENV=uat)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
