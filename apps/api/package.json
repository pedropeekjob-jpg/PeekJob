{
  "name": "@peekjob/api",
  "version": "0.1.0",
  "private": true,
  "description": "API da PeekJob (NestJS + PostgreSQL)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/verification/pdfjs-loader.cjs dist/verification/",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "migrate": "node dist/db/migrate-cli.js",
    "seed": "node dist/db/seed-cli.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest test/unit",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand test/e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "import:osm": "node dist/import/osm-cli.js",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@peekjob/shared": "*",
    "express": "5.2.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/multer": "1.4.12",
    "@types/node": "22.18.6",
    "@types/pdfkit": "0.13.5",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "pdfkit": "0.15.0",
    "supertest": "7.0.0",
    "ts-jest": "29.4.14",
    "typescript": "5.6.3"
  }
}
